{
  "name": "travel-footprint-map",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/inline-build.mjs",
    "audit:extract": "node scripts/audit/extract-overture.mjs",
    "audit:country": "node scripts/audit/country-runner.mjs",
    "audit:selector": "node scripts/audit/verify-selector-evidence.mjs",
    "audit:compare": "node scripts/audit/compare-releases.mjs",
    "audit:global": "node scripts/audit/verify-global-release.mjs",
    "audit:queue": "node scripts/audit/list-audit-queue.mjs",
    "audit:cross-country": "node scripts/audit/verify-cross-country.mjs",
    "audit:region": "node scripts/audit/verify-region-audit.mjs",
    "audit:snapshot-source": "node scripts/audit/snapshot-source-manifest.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@testing-library/dom": "10.4.1",
    "@types/node": "24.0.10",
    "adm-zip": "0.6.0",
    "eslint": "10.8.1",
    "fake-indexeddb": "6.2.4",
    "jsdom": "29.1.1",
    "shapefile": "0.6.6",
    "topojson-client": "3.1.0",
    "topojson-server": "3.0.1",
    "topojson-simplify": "3.0.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
